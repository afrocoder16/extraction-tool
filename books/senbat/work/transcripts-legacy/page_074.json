      "verse_num_am": "",
      "spans": [
        {
          "t": "በሁለተኛው ክፍለ ዘመን መጀመሪያ ላይ በሮም፣ «ካህን ወነቢይ» እየተባለ ይጠራ የነበረው ሔርማ፣ «ኖላዊ» የተባለው መምህርም፣ እግዚአብሔር ሰማያትንና ምድርን ካለመኖር (እም ኀበ አልቦ) እንደ ፈጠራቸው መስክሮአል (መጽሐፈ ሔርማን ኖላዊ ክፍል 2)።",
          "c": "black"
        }
