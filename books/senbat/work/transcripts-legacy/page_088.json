      "verse_num_am": "",
      "spans": [
        {
          "t": "ትንሣኤ ማለት መነሣት፣ መቆም ማለት ነው። ከበሸታ ድኖ መነሳት ትንሣኤ ነው። ከሠላሳ ስምንት ዓመት ጀምሮ ታሞና አልጋ ላይ ተኝቶ የነበረውን በሸተኛ (መፃጒዕ) ጌታችን ኢየስሱ ክርስቶሰ፣ «ተነሳና አልጋህን ተሸክመህ ሂድ» ባለው ጊዜ፣ በሸተኛው ሰው በጌታችን ቃል ከበሸታ ው ተፈውሶ አልጋውን ተሸክሞ ሂደ (ዮሐ.፭፦፬)።",
          "c": "black"
        }
      ],
      "bbox": [
        520,
        832,
