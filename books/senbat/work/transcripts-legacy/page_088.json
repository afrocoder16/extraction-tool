    {
      "type": "prayer",
      "verse_num_am": "",
      "spans": [
        {
          "t": "ጌታችን በአዳም ምክንያት የመጣውን ሞት ይሸር ዘንድ በተዋሐደው ሥጋ ሞቶ ተቀበረ። ከዚያም በሦስተኛው ቀን ከሙታን ተለይቶ ተነሣ። የጌታችን መስቀልና ትንሣኤ ታሪክ ባጭሩ እንደሚከተለው ነው።",
          "c": "black"
        }
      ],
      "bbox": [
        520,
        1999,
        2126,
