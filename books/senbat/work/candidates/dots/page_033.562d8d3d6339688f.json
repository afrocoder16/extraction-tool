          "content": "[{\"bbox\": [250, 226, 1314, 319], \"category\": \"Section-header\", \"text\": \"የኢትዮጵያ ኦርቶዶስ ተዋሕዶ ቤተ ክርስቲያን ሃይማኖትና ሥርዓት\\nThe Ethiopian Orthodox Tewahido Church Faith and Order\"}, {\"bbox\": [606, 321, 958, 354], \"category\": \"Text\", \"text\": \"www.ethiopianorthodox.org\"}, {\"bbox\": [596, 389, 821, 423], \"category\": \"Section-header\", \"text\": \"ምስጢረ ጥምቀት\"}, {\"bbox\": [228, 465, 857, 499], \"category\": \"Text\", \"text\": \"ጥያቄ፦ምስጢረ ጥምቀት ማለት ምን ማለት ነው?\"}, {\"bbox\": [320, 499, 1337, 563], \"category\": \"Text\", \"text\": \"ጌታችን ኢየሱስ ክርስቶስ ስለመሠረተው ሥርዓተ ጥምቀት የምንማረው ትምህርት ምስጢረ ጥምቀት ይባላል።\"}, {\"bbox\": [228, 597, 739, 631], \"category\": \"Text\", \"text\": \"ጥያቄ፦ጥምቀት ማለት ምን ማለት ነው?\"}, {\"bbox\": [320, 633, 1136, 663], \"category\": \"Text\", \"text\": \"ጥምቀት ማለት መላው ስውነት በውኃ መንከር ወይም ማጥመቅ ማለት ነው።\"}, {\"bbox\": [320, 665, 1208, 694], \"category\": \"Text\", \"text\": \"በግእዝ ልሳን «አጥመቀ አጠመቀ ነከረ» ካለው ግስ ጥምቀት የተባለው ቃል ተገኘ።\"}, {\"bbox\": [228, 730, 697, 764], \"category\": \"Text\", \"text\": \"ጥያቄ፦ ጥምቀትን የጀመረው ማነው?\"}, {\"bbox\": [320, 764, 1194, 797], \"category\": \"Text\", \"text\": \"እውነተኛዋን ጥምቀት የጀመረ ወይም የመሠረተው ጌታችን እየሱስ ክርስቶስ ነው።\"}, {\"bbox\": [228, 828, 1318, 901], \"category\": \"Text\", \"text\": \"ጥያቄ፦ጌታችን እየሱስ ክርስቶስ እውነተኛዋን ጥምቀት የመሠረተው ወይም የጀመረው መቼ ነው?\"}, {\"bbox\": [320, 904, 1332, 1001], \"category\": \"Text\", \"text\": \"ጌታችን እየሱስ ክርስቶስ ከቅድስት ድንግል ማርያም በድንግልና ተፀንሶ በድንግልና ተወልዶ ዕድሜው ሠላሳ ዓመት ያህል ሲሆነው በዮርዳኖስ ወንዝ በዮሐንስ እጅ ተጠመቀ (ሉቃስ ፫፡ ፳፩-፳፫)።\"}, {\"bbox\": [320, 1030, 1323, 1285], \"category\": \"Text\", \"text\": \"የጌታችን ጥምቀት ታሪክ ባጭሩ እንዲህ ነው፤ «ያን ግዜ ኢየሱስ በዮሐንስ ሊጠመቅ ከገሊላ ወደ ዮርዳኖስ መጣ ዮሐንስ ግን እኔ በአንተ ልጠመቅ ያስፈልገኛል፤አንተ ግን ወደ እኔ ትመጣ ለህ? ብሎ ከለከለው ኢየሱስም መልሶ አሁንስ ተው እንዲህ ጽድቅን ሁሉ መፈጸም ይገባልና አለው። ያን ግዜ ፈቀደለት። ኢየሱስ ከተጠመቀ በኃላ ወዲያው ከውኃ ወጣ እነሆም ስማያት ተከፈቱ፤ የእግዚአብሔር መንፈስ እንደ ርግብ ሲወርድ በእርሱም ላይ ሲቀመጥ አየ፤ እነሆም ድምፅ ከስማይ መጥቶ በእርሱ ደስ የሚለኝ የምወደው ልጆ ይህ ነው አለ» (ማቴ ፲፫፤፲፯)። ማርቆሰ፤ ሉቃስና ዮሐንስም የጥምቀቱን ታሪክ ከማቴዎስ ጋር አስማምተው መዝግበውታል፤ (ማር ፩፥፱-፲፩ ሉቃ ፫፥፳፩-፳፫ ዮሐ ፩፥ ፴፪-፴፬)።\"}, {\"bbox\": [228, 1315, 1298, 1389], \"category\": \"Text\", \"text\": \"ጥያቄ፦ጌታችን ኢየሱስ ክርስቶስ በማየ ዮርዳኖስ በእደ ዮሐንስ ሲጠመቅ የተፈጸሙ ታሪኮች ምንና ምን ናቸው?\"}, {\"bbox\": [320, 1421, 1127, 1453], \"category\": \"Text\", \"text\": \"ጌታችን ሲጠመቅ የተፈጸሙት አስደናቂ ስራዎች ከዚህ የሚከተሉት ናቸው፦\"}, {\"bbox\": [320, 1453, 793, 1486], \"category\": \"Text\", \"text\": \"፩ ስማያት ተከፈተዋል (ሲከፈቱ ታይተዋል)፤\"}, {\"bbox\": [320, 1486, 1213, 1517], \"category\": \"Text\", \"text\": \"፪ መንፈስ ቅዱስ በርግብ አምሳል ወርዶ በኢየሱስ ራስ ላይ ረቦ ሲያርፍ ታይቶአል፤\"}, {\"bbox\": [320, 1517, 1303, 1578], \"category\": \"Text\", \"text\": \"፫ እግዚአብሔር አብ የምወደው ልጆ(የባህርይ ልጆ) ይህ ነው ብሎ ድምጹን አስምቶ መስክ ሮለታል፤\"}, {\"bbox\": [320, 1578, 1335, 1741], \"category\": \"Text\", \"text\": \"፬ በቅዱስ ዳዊት የተነገረው ትንቢት ይፈጸም ዘንድ ጌታችን ይጠመቅ ዘንድ ዮርዳኖስ በሂደ ግዜ የዮርዳኖስ ወንዝ ባልተለመደ ሁኔታ ሲጨነቅ፤ ከቦታው ለመሸሸ ሲሞክር ታይታል። ዮርዳኖስ ወራጅ ውኃዎች ሁሉ ፈርተዋል፤ በዚህ ግዜ ቅዱስ ዳዊት በመንፈስ ቅዱስ ተመርቶ(ተቃኝቶ)፤ «ባህር አይታ ሸሸች ዮርዳኖስም ወደ ኃላው ተመለስ» ሲል የተናገረው ትንቢት ተፈጸመ (መዝ. ፪፲፫:(፪፲፬) ፫-፭)።\"}, {\"bbox\": [606, 1892, 958, 1925], \"category\": \"Text\", \"text\": \"www.ethiopianorthodox.org\"}]",
