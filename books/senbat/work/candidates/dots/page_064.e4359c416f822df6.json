      {
        "type": "prayer",
        "verse_num_am": "",
        "spans": [
          {
            "t": "በዚህ ዓይነት ኢያሱ በሙሴ ተቾሞ፤ እንደ ሙሴ ኹሉ፤ መስፍነ እስራኤልና ነቢየ እስራኤል ኾነ። እስራኤልን በመጠበቅ፣ በማስወጣትና፣ በማስገበት፣ በመመገብና በመንከባከብ ረገድ ኢያሱ እጅግ የታወቀና የተመሰገነ መስፍንና ነቢይ ኾነ።",
            "c": "black"
          }
        ],
        "bbox": [
