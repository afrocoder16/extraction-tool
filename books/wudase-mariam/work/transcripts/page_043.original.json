        { "t": "፳፮  የረቡዕ ውዳሴ ማርያም", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "",
      "spans": [
        { "t": "ደስ የተሰኘህ ሆነህ ምሥራችን የተናገርክ መልአኩ ", "c": "black" },
        { "t": "ገብርኤል ሆይ", "c": "red" },
        { "t": " የተሰጠህ ክብር ታላቅ ነው ወደእኛ የመጣ የጌታን ልደት ነገርከን ለድንግል ", "c": "black" },
        { "t": "ማርያም", "c": "red" },
        { "t": " ጸጋን የተመላሽ ሆይ ", "c": "black" },
        { "t": "እግዚአብሔር", "c": "red" },
        { "t": " ካንቺ ጋር ነውና ደስ ይበልሽ ብለህ አበሰርካት። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፭",
      "spans": [
        { "t": "ጸጋን አገኘሽ መንፈስ ቅዱስ አደረብሽ የልዑል ኃይልም ጋረደሽ (ጸለለብሽ) ", "c": "black" },
        { "t": "ማርያም ሆይ", "c": "red" },
        { "t": " በእውነት ቅዱሱን ወለድሽ ዓለምን ሁሉ የሚያድን መጥቶ አዳነን። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፮",
      "spans": [
        { "t": "አንደበታችን የድንግልን ሥራ ያመስግናል። ጌታችንና መድኃኒታችን ", "c": "black" },
        { "t": "ኢየሱስ ክርስቶስ", "c": "red" },
        { "t": " በዳዊት አገር ከእርስዋ ስለተወለደ አምላክን የወለደች ", "c": "black" },
        { "t": "ማርያምን", "c": "red" },
        { "t": " ዛሬ እናመስግናት አሕዛብ ኑ ", "c": "black" },
        { "t": "ማርያምን", "c": "red" }
      ]
    }
  ]
}
