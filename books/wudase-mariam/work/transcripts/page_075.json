    {
      "type": "verse",
      "verse_num_am": "፫",
      "spans": [
        { "t": "ንጽሕት ድንግል ማርያም", "c": "red" },
        { "t": " የታመነች ", "c": "black" },
        { "t": "አምላክን", "c": "red" },
        { "t": " የወለደች ናት። ለሰው ልጆችም የምሕረት አማላጅ ናት። ኃጢአታችንን ያስተሠርይልን ዘንድ ወደ ልጅሽ ወደ ", "c": "black" },
