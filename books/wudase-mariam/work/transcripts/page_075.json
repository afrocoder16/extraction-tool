        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፬",
      "spans": [
        { "t": "ድንግል ማርያም", "c": "red" },
        { "t": " በቤተመቅደስ አስምታ ትናገር ነበር። ", "c": "black" },
        { "t": "መልአኩ ቅድስት ድንግል ሆይ", "c": "red" },
        { "t": " ሰላምታ ይገባሻል ብሎ አክብሮ ከነገረኝ ነገር በቀር ምንም ምን ሌላ የማውቀው እንደሌለኝ ", "c": "black" },
        { "t": "እግዚአብሔር", "c": "red" },
        { "t": " ያውቃል አለች። የማይቻለውን ቻልሽ የማይወሰነውንና ምንም ምን የሚወስነው የሌለውን ወሰንሽ። በክብር ሁሉ ላይ ጸጋን የተመላሽሆይ ምስጋናሽ ይበዛል ክብርሽ ፍጹም ነው። የአብ ቃል ማደሪያ ምእመናን የክርስቲያን ወገኖች ምእመናንን የምትሰበስቢያቸውና", "c": "black" }
      ]
