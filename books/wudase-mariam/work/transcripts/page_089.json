      "spans": [
        {
          "t": "ከሴቶሽ ይልቅ ተለይተሽ የተባረክሽ ሆይ የተወደድሽ ተባልሽ። ከተለዩ የተለየች በውስጧም የኪዳን የሕግ ጽላት ያለባት የምትባይ ሁሉተኛ ክፍል አንቺ ነሽ ጪዳንም ",
          "c": "black"
        },
        {
          "t": "በእግዚአብሔር",
          "c": "red"
        },
        {
          "t": " ጣቶሽ የተጻፉ ዓሥሩ ቃላት ናቸው። ያለመለወጥ ",
          "c": "black"
        },
        {
          "t": "ካንቺ ሰው የሆነ መድኃኒታችን ኢየሱስ ክርስቶስ",
          "c": "red"
        },
        {
          "t": " ደገኛ ስሙን መጀመሪያ ስሙን አስቀድሞ በየውጣ ነገረን፣ ለአዲስ ጪዳንም አስታራቂ ሆነ። በከበረ ደሙ ፈሳሽነት ወይም መፍሰስ ያመኑትንና ንጹሓን የሆኑትን ወገኖች አነጻቸው። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
