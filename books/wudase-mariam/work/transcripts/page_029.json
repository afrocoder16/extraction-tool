        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፬",
      "spans": [
        {
          "t": "ሙሴ በነደ እሳት ሳትቃጠል ያያት ዕፅ አንቺ ነሽ ይኸውም መጥቶ በማኅፀንሽ ያደረው ",
          "c": "black"
        },
        {
          "t": "የእግዚአብሔር ልጅ",
          "c": "red"
        },
        {
          "t": " ነው የመለኮቱ እሳትነት ሥጋሽን አላቃጠለውም። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፭",
      "spans": [
        {
          "t": "ዘር ያልተዘራባት እርሻ አንቺ ነሽ የሕይወት ፍሬ ከአንቺ ወጣ። ዮሴፍ የዋጃትና የከበረ ዕንቁን ያገኘባት ሣጥን አንቺ ነሽ ይኸውም ",
          "c": "black"
        },
        {
          "t": "መድኃኒታችን ኢየሱስ ክርስቶስ",
          "c": "red"
        },
        {
          "t": " ነው በማኅፀንሽ አደረ በዚህ ዓለምም ወለድሽው። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፮",
      "spans": [
        {
          "t": "የመላእክት ደስታቸው የሆነ ",
          "c": "black"
        },
        {
          "t": "ጌታን የወለድሽ ሆይ",
          "c": "red"
        },
        {
          "t": " ደስ ይበልሽ። የነቢያት ዜናቸው ንጽሕት ሆይ ደስ ይበልሽ። ",
          "c": "black"
        },
        {
          "t": "እግዚአብሔር",
          "c": "red"
        },
        {
          "t": " ከአንቺ ጋር ቢሆን ባለሟልነትን አግኝተሻልና ደስ ይበልሽ። የዓለም የሰው ሁሉ ደስታ የሆነ የመልአኩን ቃል ተቀብለሻልና ደስ ይበልሽ። ",
          "c": "black"
        }
      ]
    }
  ]
}