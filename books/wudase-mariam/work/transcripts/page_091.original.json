    {
      "type": "verse",
      "verse_num_am": "፪",
      "spans": [
        { "t": "ሁል ጊዜ ንጽሕት የሆንሽ ", "c": "black" },
        { "t": "አምላክን የወለድሽ እመቤታችን ሆይ", "c": "red" },
        { "t": " ሁላችን ስለዚህ እናገንሻለን ሰውን በሚወድ በጌታ ዘንድ ይቅርታን እናገኝ ዘንድ እንለምንሻለን ወዳንቺም እናንጋጥባለን።", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፫",
      "spans": [
        { "t": "ከማይነቅዝ እንጨት የተቀረፀ በውስጥና በውጭ በወርቅ የተለበጠ ታቦት ያለመለየትና ያለመለወጥ ሰው የሆነ ", "c": "black" },
        { "t": "የእግዚአብሔርን ቃል", "c": "red" },
        { "t": " ይመስልልናል። ይኸውም መለወጥ የሌለበት ንጹሕ ", "c": "black" },
        { "t": "መለኮት ነው ከአብ", "c": "red" },
        { "t": " ጋር የተካከለ ነው ለንጽሕት በራሱ አበሠራት። በልዩ ጥበቡ ያለ ወንድ ዘር እንደ እኛ ሆነ ", "c": "black" },
        { "t": "መለኮቱን", "c": "red" },
        { "t": " አዋሕዶ ያለ ርኩሰት ባንቺ ሰው ሆነ። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
