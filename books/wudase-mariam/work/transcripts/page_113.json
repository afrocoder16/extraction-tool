      "spans": [
        {
          "t": "የብርሃን መጋረጃና የማይመረመር የክብር (የጌትነት) ዙፋን አንቺ ነሽ ",
          "c": "black"
        },
        {
          "t": "ቅድስት ማሪያም ሆይ መንፈስ ቅዱስ",
          "c": "red"
        },
        {
          "t": " መጥቶ ስላደረብሽና ",
