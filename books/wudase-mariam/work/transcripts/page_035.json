    {
      "type": "verse",
      "verse_num_am": "፲፩",
      "spans": [
        {
          "t": "የድንግልን ገናንነቷን ሊናገሩት አይቻልም ጌታ መርጧታልና የሚቀርበው በሌለ ብርሃን ውስጥ የሚኖር እርሱ መጥቶ አደረባት ዘጠኝ ወር በማኅፀኗ አደረ የማይታይና የማይመረመር (ታይቶ የማይታወቅ) እርሱን በድንግልና ወለደችው። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፲፪",
      "spans": [
        {
          "t": "ነቢዩ ዳንኤል ያየው ያለ እጅ ከረጅም ተራራ የተፈነቀለው ያ ድንጋይ ከአብ ዘንድ የወጣው ቃል ነውና መጥቶ ያለ ወንድ ዘር ከድንግል ተወልዶ አዳነን። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፲፫",
      "spans": [
        {
          "t": "እንደ ንጹሕ ጽዋ ሆንሽ የሃይማኖትም መገኛ ነሽ የቀናች የቅዱሳን አባቶቻችን ሃይማኖታቸው ነሽ። አምላክን የወለድሽና በድንግልና የታተምሽ ንጽሕት ሆይ የአብን ቃል ወለድሽልን ",
          "c": "black"
