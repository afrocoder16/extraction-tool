    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        { "t": "፳፱  የረቡዕ ውዳሴ ማርያም", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "",
      "spans": [
        { "t": "በቅዱሳን ላይ የሚያድር ", "c": "black" },
        { "t": "እግዚአብሔር", "c": "red" },
        { "t": " እኛን ለማዳን ልዩ ከሆነች ድንግል ሰው ሆኗልና። ኑ ይህን ድንቅ እዩ። ስለ ተገለጠልን ምሥጢር ምስጋና አቅርቡ። ሰው የማይሆን ሰው ሆኗልና። ቃል ተዋሕዷልና ጥንት የሌለው ሥጋ ጥንታዊ ቀዳማዊ ሆነ። ዘመን የማይቆጠርለት መለኮት ዘመን ተቆጠረለት። የማይታወቅ ተገለጠ የማይታይ ታየ ", "c": "black" },
        { "t": "የሕያው የእግዚአብሔር ልጅ", "c": "red" },
        { "t": " በእርግጥ ሰው ሆነ። ትላንት የነበረው ዛሬም ያለው መቼም የሚኖረው ", "c": "black" },
        { "t": "ኢየሱስ ክርስቶስ", "c": "red" },
        { "t": " እንሰግድለት እናመስግነው ከአብ አንድ ባሕርይ ነው። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፰",
      "spans": [
        { "t": "ነቢዩ ሕዝቅኤል ስለ እርስዋ መሰከረ ድንቅ በሆነ ታላቅ ቁልፍ የተዘጋች ደጅ ምሥራቅ አየሁ አለ ከኃያላን ጌታ በቀር", "c": "black" }
      ]
    }
  ]
