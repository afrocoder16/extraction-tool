      "spans": [
        {
          "t": "ዓርብ የሚጸለይ አምላክን የወለደች የእመቤታችን የድንግል ማርያም ምስጋና",
          "c": "red"
        }
      ]
    },
    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        {
          "t": "አምስተኛ ክፍል",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፩",
      "spans": [
        {
          "t": "ከሴቶች ተለይተሽ የተባረክሽ ነሽ። የማኅፀንሽም ፍሬ የተባረክ ነው ያለርኩሰት አምላክን የወለድሽ ድንግል ",
          "c": "black"
        },
        {
          "t": "ማርያም",
          "c": "red"
        },
        {
          "t": " ሆይ እውነተኛ ፀሐይ ከአንቺ ወጣልን (ጌታ ተወለደልን) በክንፈ ረድኤቱም አቀረበን። እርሱ ፈጥሮናልና። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፪",
      "spans": [
        {
          "t": "አምላክን የወለድሽ እመቤታችን ሆይ",
          "c": "red"
        },
        {
          "t": " የብርሃን እናት ነሽና አንቺን ብቻሽን በክብር በምስጋና እናገንሻለን።",
          "c": "black"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፫",
      "spans": [
        {
          "t": "የተባረክሽ አንቺ ከመላእክት ከመላእክት ትበልጫለሽ ካያቀቀ ኣደምም ትበልመላሽ ከድቂቀ አዳምም ትበልጫለሽ፡፡ ከአሳቦች",
          "c": "black"
        }
      ]
    }
  ]
