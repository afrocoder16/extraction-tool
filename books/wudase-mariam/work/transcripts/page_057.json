    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        { "t": "፴፪  የሐሙስ ውዳሴ ማርያም", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "",
      "spans": [
        { "t": "ስለዚህ አምላክን የወለደች እንደሆነች ታወቀች። ", "c": "black" },
        { "t": "የእግዚአብሔር", "c": "red" },
        { "t": " የጥበቡ ስፋት ምን ይጠልቅ? በጻዕር በምጥ በልብ ጋር ትወልድ ዘንድ የፈረደባት ማኅፀን የሕይወት መገኛ ሆነች ከባሕርያችን እርግማንን የሚያጠፋልንን ያለ ወንድ ዘር ወለደችልን። ስለዚህም ሰውን የምትወድ ሆይ ክብር ላንተ ይገባል ቸርና የሰውነታችን መድኃኒትም ነህ እያልን እናመስግነው። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፬",
      "spans": [
        { "t": "ያለ ወንድ ዘር አምላክን የወለደች ድንግል የማኅፀኗ ሥራ ምን ይደንቅ? ለዮሴፍ የታየው መልአኩ ከእርሷ በመንፈስ ቅዱስ የሚወለደው ያለ መለወጥ ሰው የሚሆነው ", "c": "black" },
        { "t": "የእግዚአብሔር", "c": "red" },
        { "t": " ቃል ነው ብሎ መስክሯልና። ", "c": "black" },
        { "t": "ማርያም", "c": "red" },
        { "t": " የዚህ ደስታ ዕፅፍ የሆነ እርሱን", "c": "black" }
      ]
    }
  ]
}
