      "spans": [
        {
          "t": "ወለደችው። መልአኩ ልጅ ትወልጃለሽ ስሙም አማኑኤል ይባላል አላት። ትርጓሜውም ",
          "c": "black"
        },
        {
          "t": "እግዚአብሔር",
          "c": "red"
        },
        {
          "t": " ከእኛ ጋር ሆነ ማለት ነው። ዳግመኛ ወገኖቹን ከኃጢአታቸው የሚያድናቸው ",
          "c": "black"
        },
        {
          "t": "ኢየሱስ",
          "c": "red"
        },
        {
          "t": " ይባላል። በችሎታው (በኃይሉ) ያድነን ዘንድ ኃጢአታችንንም ያስተሠርይልን ዘንድ ለዘለዓለም ክብር ይግባውና ሰው የሆነ እርሱን ",
          "c": "black"
        },
        {
          "t": "አምላክ",
          "c": "red"
        },
        {
          "t": " እንደሆነ በተረዳ ነገር አውቀነዋልና። ልዩ ከሆነች ድንግል ማርያም ይህ የአምላክ መወለድ ምን ይደንቅ ቃልን ወሰነችው። ልደቱንም ዘር አልቀደመውም። በመወልዱም ድንግልናዋን አልለወጠውም። ቃል ከአብ ያለ ድካም ወጣ። ከድንግልም ያለ ሕማም ተወለደ። ሰብአ ሰገል ሰገዱለት ",
          "c": "black"
        },
