    {
      "type": "verse",
      "verse_num_am": "፪",
      "spans": [
        { "t": "አምላክን", "c": "red" },
        { "t": " የወለድሽ እመቤታችን ሆይ ትውልድ ሁሉ አንቺን ብቻ ያመሰግኑሻል።", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፫",
      "spans": [
        { "t": "የእግዚአብሔር", "c": "red" },
        { "t": " ሀገር (ከተማ) ሆይ ነቢያት ድንቅ ድንቅ ነገርን ተናገሩልሽ። ደስ የተሰኙ የጻድቃን ማደሪያ ሆነሻልና የምድር ነገሥታት ሁሉ በብርሃንሽ ይሄዳሉ። ሕዝቡም ሠራዊቶቻቸውም በብርሃንሽ ይሄዳሉ። ", "c": "black" },
        { "t": "ማርያም ሆይ", "c": "red" },
        { "t": " ትውልድ ሁሉ ያመሰግኑሻል ካንቺ ለተወለደውም ይሰግዱለታል ያገኑታልም። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፬",
      "spans": [
        { "t": "የዝናብ ውኃ የታየብሽ የእውነት ደመና አንቺ ነሽ። አብ የልጁ ምልክት አደረገሽ መንፈስ ቅዱስ አደረብሽ የልዑል ኃይል ጋረደሽ። ", "c": "black" },
        { "t": "ማርያም ሆይ", "c": "red" },
        { "t": " ለዘለዓለም የሚኖር የአብን ልጅ ቃልን የወለድሽልን", "c": "black" }
      ]
    }
  ]
