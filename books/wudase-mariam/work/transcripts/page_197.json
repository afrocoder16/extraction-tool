        {
          "t": "ይህቺን መጽሐፍ",
          "c": "red"
        },
        {
          "t": " በንጽህና የያዘ ሰው የሰራዊተ መላእክት አለቆች ዘወትር እየመጡ ይጎበኙታል። ",
          "c": "black"
        },
        {
          "t": "እናቴ ማርያም",
          "c": "red"
        },
        {
          "t": " ሆይ በሰማይና በምድር ይህን ሁሉ አስራት (ተስፋ) ሰጠሁሽ፤ ብሩክት መርገመ ሥጋ መርገመ ነፍስ የሌለባት እመቤታችንም ",
          "c": "black"
        },
        {
          "t": "ልጆ ወዳጆ ሆይ፤",
          "c": "red"
        },
        {
          "t": " የምትለኝን ሁሉ እውነት ነውን? አለችው ጌታም መልሶ ",
          "c": "black"
        },
        {
          "t": "እናቴ ማርያም ሆይ፤ በእግዚአብሔር አባቴ በክርስቶስ",
          "c": "red"
        },
        {
          "t": " ስሜ በእውነት መንፈስ በጳራቅሊጦስ እውነት እንደሆነ ቃል ኪዳን ገባሁልሽ አላት። መልአከ ምክሬ በሆነ ",
          "c": "black"
        },
        {
          "t": "በሚካኤል",
          "c": "red"
        },
        {
          "t": " የመወለዴን ዜና በአበሰረ ",
          "c": "black"
        },
        {
          "t": "ገብርኤል ቃል ኪዳን ገባሁልሽ",
          "c": "red"
        },
        {
          "t": " ክንፋቸው ስድስት በሆነ ምሉአነ አእይንት በሆኑ መንበሬን በሚሸከሙ አራቱ እንሰሳት ",
          "c": "black"
        },
        {
          "t": "(ኪሩቤል) ቃል",
          "c": "red"
        },
        {
          "t": " ኪዳን ገባሁልሽ አናናሬን በአንድነት ",
          "c": "black"
        },
