        {
          "t": "፶፯  የቅዳሜ ውዳሴ ጸሎት",
          "c": "black"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፪",
      "spans": [
        {
          "t": "ጸጋን የተመላሽ ሆይ ደስ ይበልሽ። ባለሟልነትን አግኝተሻልና ደስ ይበልሽ። ",
          "c": "black"
        },
        {
          "t": "እግዚአብሔር",
          "c": "red"
        },
        {
          "t": " ካንቺ ጋር ነውና ደስ ይበልሽ።",
          "c": "black"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፫",
      "spans": [
        {
          "t": "ግርማ ያለሽ ",
          "c": "black"
        },
        {
          "t": "ድንግል ሆይ",
          "c": "red"
        },
        {
          "t": " ገናንነትሽን እናመሰግናለን እናደንቃለን። እንደ ",
          "c": "black"
        },
        {
          "t": "መልአኩ ገብርኤልም",
          "c": "red"
        },
        {
          "t": " ምስጋና እናቀርብልሻለን የባሕርያችን መዳን በማኅፀንሽ ፍሬ ተገኝቷልና። ወደ አባቱ ወደ ",
          "c": "black"
        },
        {
          "t": "እግዚአብሔር",
          "c": "red"
        },
        {
          "t": " ቀረብን። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፬",
      "spans": [
        {
          "t": "እንደ ሠርግ ቤት ጉድፍ የሌለብሽ ነሽ ",
          "c": "black"
        },
        {
          "t": "መንፈስ ቅዱስ",
          "c": "red"
        },
        {
          "t": " አድሮብሻልና። የልዑል ኃይልም ጸልሎሻልና። ",
          "c": "black"
        },
        {
          "t": "ማርያም ሆይ",
          "c": "red"
        },
        {
          "t": " ለዘለዓለም የሚኖር መጥቶ ከኃጢአት ያዳነን የአብ ልጅ ቃልን በእውነት ወለድሽ። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    }
  ]
}