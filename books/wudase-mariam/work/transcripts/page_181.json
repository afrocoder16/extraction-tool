      "spans": [
        {
          "t": "ከባህርይ አባቴ ከአብ ከባህርይ ሕይወቴ ከመንፈስ ቅዱስ",
          "c": "red"
        },
        {
          "t": " ፊት አቀርበዋለሁ። የታመመዉንም በስምሽ የጎበኘ ታሞ በአልጋላይ በተኛ ጊዜ እጎበኘዋለሁ። ከዚህ ከሚያልፈው ዓለም ወደማያልፈው ዓለም በሞት በተለየ ጊዜም መሪር የሆነ የሞት ጽዋን አላጠጣዉም። ወደ መንግስተ ሰማያት እስኪገባ ድረስ አልለየዉም ርኩሳን መናፍስትም በተከራከሩት ጊዜ እኔ ጠባቂ እሆነዋለሁ በችግሩም ጊዜ ረዳት እሆነዋለሁ። ",
          "c": "black"
        },
        {
          "t": "ዳግመኛም በስምሽ",
          "c": "red"
        },
        {
          "t": " ለታረዘ (ለተራቆተ) ላለበሰ በሰው እጅ ያልተፈተለና ያልተሰራ ኅብሩ ዕፁብ ድንቅ የሆነ የሕይወት ልብስ አለብሰዋለሁ። የማይጠፋ የማይጠወልግ የሕይወት አክሊልም አቀዳጀዋለሁ ",
          "c": "black"
        },
        {
          "t": "ስለአንቺም",
          "c": "red"
