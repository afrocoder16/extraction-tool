    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        {
          "t": "፳፬  የማክሰኞ ውዳሴ ማርያም",
          "c": "black"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "",
      "spans": [
        {
          "t": "ንጉሥ (የክብር ባለቤት) ይህ ነው። በይቅርታው ብዛት የዓለምን ኃጢአት ያስተሰርይ ዘንድ የመጣው ይህ ነው ይላሉ። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    },
    {
      "type": "ornament",
      "verse_num_am": "",
      "spans": []
    },
    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        {
          "t": "ረቡዕ የሚጸለይ አምላክን የወለደች የእመቤታችን የድንግል ማርያም ምስጋና",
          "c": "red"
        }
      ]
    },
    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        {
          "t": "ሦስተኛ ክፍል",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፩",
      "spans": [
        {
          "t": "የምድር ሁለተኛ የሆንሽ ሰማይ ሆይ የሰማያት ሠራዊት (መላእክት) ንጽሕት ነሽ ይላሉ። ድንግል ",
          "c": "black"
        },
        {
          "t": "ማርያም",
          "c": "red"
        },
        {
          "t": " የምሥራቅ ደጅ ናት። ሙሽራዋ ንጹሕ የሆነ ንጽሕት የሠርግ ቤት ናት። አብ በሰማይ አይቶ እንዳንቺ ያለ አላገኘምና አንድ ልጁን ላከው በአንቺም ሰው ሆነ። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    }
  ]
}