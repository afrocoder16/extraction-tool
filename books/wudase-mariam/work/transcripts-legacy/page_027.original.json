  "blocks": [
    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        { "t": "፲፰  የማክሰኞ ውዳሴ ማርያም", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "",
      "spans": [
        { "t": "ቃል በወለደችልን። በድንግል ", "c": "black" },
        { "t": "ማርያም", "c": "red" },
        { "t": " ተገለጠልን። ሰው ከሆነ በኋላም ፍጹም ", "c": "black" },
        { "t": "አምላክ", "c": "red" },
        { "t": " ነው ስለዚህም በድንግልና ወለደችው። ድንቅ የሆነ የመውለዷ ችሎታ የማይመረመር ሊነገር የማይቻል ነው። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፪",
      "spans": [
        { "t": "በእርሱ ፈቃድ በአባቱ ፈቃድ ", "c": "black" },
        { "t": "በመንፈስ ቅዱስ", "c": "red" },
        { "t": " ፈቃድ መጥቶ አዳነን።", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፫",
      "spans": [
        { "t": "በድንግልና ፍጽምት የሆንሽ ", "c": "black" },
        { "t": "ማርያም ሆይ", "c": "red" },
        { "t": " የድንግልናሽ ምሥጋናና ክብር ታላቅ ነው። ", "c": "black" },
        { "t": "እግዚአብሔር", "c": "red" },
        { "t": " ካንቺ ጋር ቢሆን ባለሟልነትን አግኝተሻልና። ያዕቆብ ከምድር እስከ ሰማይ ደርሳ ", "c": "black" },
        { "t": "የእግዚአብሔር", "c": "red" },
        { "t": " መላእክት ሲወጡባት ሲወርዱባት ያያት መሰላል አንቺ ነሽ።", "c": "black" }
      ]
    }
  ]
}
