      "spans": [
        { "t": "፳፫  የማክሰኞ ውዳሴ ማርያም", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፲፬",
      "spans": [
        { "t": "የከበርሽ ጌታን የወለድሽ ሆይ የማይታይ ቃልን የተሸከምሽው የብርሃን እናት አንቺ ነሽ። እርሱን ከወለድሽው በኋላ በድንግልና ኖረሻልና በፍጹም ምስጋና ያገኑሻል። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፲፭",
      "spans": [
        { "t": "የአብ ቃል እናቱ ንጽሕት ", "c": "black" },
        { "t": "ድንግል ሆይ", "c": "red" },
        { "t": " ስለአንቺ የሚነገረውን ነገር መናገር የሚቻለው ምን አንደበት ነው። ኪሩቤል ለሚሸከሙት ንጉሥ ዙፋኑ (ማደሪያው) ሆንሽ። የተከበርሽ ሆይ እናመሰግንሻለን ", "c": "black" },
        { "t": "የጌታችን የኢየሱስ ክርስቶስ", "c": "red" },
        { "t": " እናት መልካሟ እርግብ ሆይ ስምሽን በልጅ ልጅ እንጠራለን። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፲፮",
      "spans": [
        { "t": "እናትና ገረድ ", "c": "black" },
        { "t": "ማርያም", "c": "red" },
        { "t": " ሆይ ደስ ይበልሽ። የታቀፍሽውን መላእክት ያመሰግኑታል ኪሩቤልም በፍርሃት ይሰግዱለታልና ሱራፌልም ያለማቋረጥ", "c": "black" }
      ]
    }
  ]
