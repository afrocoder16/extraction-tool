  "corrections": [],
  "blocks": [
    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        { "t": "፴፫  የሐሙስ ውዳሴ ማርያም", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "",
      "spans": [
        { "t": "ወለደችው። መልአኩ ልጅ ትወልጃለሽ ስሙም ", "c": "black" },
        { "t": "አማኑኤል", "c": "red" },
        { "t": " ይባላል አላት። ትርጓሜውም ", "c": "black" },
        { "t": "እግዚአብሔር", "c": "red" },
        { "t": " ከእኛ ጋር ሆነ ማለት ነው። ዳግመኛ ወገኖቹን ከኃጢአታቸው የሚያድናቸው ", "c": "black" },
        { "t": "ኢየሱስ", "c": "red" },
        { "t": " ይባላል። በችሎታው (በኃይሉ) ያድነን ዘንድ ኃጢአታችንንም ያስተሠርይልን ዘንድ ለዘለዓለም ክብር ይግባውና ሰው የሆነ እርሱን ", "c": "black" },
        { "t": "አምላክ", "c": "red" },
        { "t": " እንደሆነ በተረዳ ነገር አውቀነዋልና። ልዩ ከሆነች ድንግል ", "c": "black" },
        { "t": "ማርያም", "c": "red" },
        { "t": " ይህ የአምላክ መወለድ ምን ይደንቅ ቃልን ወሰነችው። ልደቱንም ዘር አልቀደመውም። በመወለዱም ድንግልናዋን አልለወጠውም። ቃል ከአብ ያለ ድካም ወጣ። ከድንግልም ያለ ሕማም ተወለደ። ሰብአ ሰገል ሰገዱለት ", "c": "black" },
        { "t": "አምላክ", "c": "red" },
        { "t": " ነውና ዕጣን አመጡለት ንጉሥም ነውና ወርቅ አመጡለት ስለእኛ በፈቃዱ", "c": "black" }
      ]
    }
  ]
}
