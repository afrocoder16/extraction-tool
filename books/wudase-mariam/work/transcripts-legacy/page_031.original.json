    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        { "t": "፳  የማክሰኞ ውዳሴ ማርያም", "c": "black" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "",
      "spans": [
        { "t": "ይበልሽ። ዓለምን ሁሉ የፈጠረ ጌታን የወለድሽ ሆይ ደስ ይበልሽ። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፯",
      "spans": [
        { "t": "በሚገባ የአምላክ እናት ተብለሻልና ደስ ይበልሽ። የሔዋን መድኃኒት ሆይ ደስ ይበልሽ። ፍጥረቱን ሁሉ የሚመግበውን እርሱን ጡትሽን አጥብተሽዋልና ደስ ይበልሽ። የሕያዋን (የጻድቃን) ሁሉ እናታቸው ", "c": "black" },
        { "t": "ቅድስት ሆይ ደስ ይበልሽ።", "c": "red" },
        { "t": " ተማጽነን ዘንድ ወደ አንቺ እናንጋጥጣለን። ", "c": "black" },
        { "t": "ቅድስት ሆይ ለምኝልን።", "c": "red" }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፰",
      "spans": [
        { "t": "ድንግል ሆይ ቅድስት ሆይ", "c": "red" },
        { "t": " ጌታን የወለድሽ ሆይ እኛን ለማዳን ድንቅ ምሥጢር (ተዋሕዶ) በአንቺ ቢደረግ ንጉሥን ወልደሽልናልና ፍጥረታትን በልዩ ልዩ መልክ የፈጠረ የእርሱን የገናንነቱን ነገር ፈጽመን መናገር አይቻልምና ዝም እንበል። ", "c": "black" },
        { "t": "ቅድስት ሆይ", "c": "red" }
      ]
    }
  ]
}
