    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        {
          "t": "ሐሙስ የሚጸለይ አምላክን የወለደች የእመቤታችን የድንግል ማርያም ምስጋና",
          "c": "red"
        }
      ]
    },
    {
      "type": "title",
      "verse_num_am": "",
      "spans": [
        {
          "t": "ዐራተኛ ክፍል።",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፩",
      "spans": [
        {
          "t": "ርኩሰት የሌለባት ድንግል ",
          "c": "black"
        },
        {
          "t": "ማርያም",
          "c": "red"
        },
        {
          "t": " ሙሴ በበረሃ በነደ እሳት ጫፎቿ ሳይቃጠሉ ያያት ዕፅን ትመስላለች። የአብ ቃል በርስዋ ሰው ሆኗልና። እሳተ መለኮቱ (የመለኮቱ ባሕርይ) አላቃጠላትምና ከወለደችውም በኋላ ድንግልናዋ አልተለወጠምና ሰውም ቢሆን መለኮቱ አልተለወጠም። በእውነት ሰው ነውና በእውነት አምላክ የሆነ እርሱ መጥቶ አዳነን። ",
          "c": "black"
        },
        {
          "t": "ቅድስት ሆይ ለምኝልን።",
          "c": "red"
        }
      ]
    },
    {
      "type": "verse",
      "verse_num_am": "፪",
      "spans": [
        {
          "t": "አምላክን የወለድሽ እመቤታችን ሆይ",
          "c": "red"
        },
        {
          "t": " ሁላችን እናገንሻለን። ይቅርታሽ ለሁላችን ይሆን ዘንድ ነውና።",
          "c": "black"
        }
      ]
    }
  ]
}